## Fitting moderated 2*2 factorial models
from scipy import stats
from scipy.special import digamma, polygamma
from scipy.optimize import brentq

def trigamma_inverse(x):
    """limma's trigammaInverse."""
    y = np.asarray(x, float)
    out = np.empty_like(y)
    for i,v in enumerate(y):
        if not np.isfinite(v) or v<=0: out[i]=np.nan; continue
        if v > 1e7: out[i]=1/np.sqrt(v); continue
        if v < 1e-6: out[i]=1/v; continue
        z = 0.5 + 1/v
        for _ in range(60):
            tri = polygamma(1,z); tet = polygamma(2,z)
            dz = tri*(1-tri/v)/tet
            z += dz
            if abs(dz/z) < 1e-10: break
        out[i]=z
    return out

def squeeze_var(s2, df):
    """Smyth (2004) empirical Bayes variance moderation -> (d0, s0^2)."""
    s2 = np.asarray(s2,float); df=np.asarray(df,float)
    ok = np.isfinite(s2) & (s2>0) & (df>0)
    z = np.log(s2[ok]); dfo = df[ok]
    e = z - digamma(dfo/2) + np.log(dfo/2)
    ebar = e.mean()
    n = ok.sum()
    evar = ((e-ebar)**2).sum()/(n-1) - np.mean(polygamma(1,dfo/2))
    if evar > 0:
        d0 = 2*trigamma_inverse(np.array([evar]))[0]
        s02 = np.exp(ebar + digamma(d0/2) - np.log(d0/2))
    else:
        d0 = np.inf; s02 = np.exp(ebar)
    return d0, s02

def fit_2x2(M, meta, coefs=('Severity','Immune','Interaction')):
    """OLS per protein + eBayes moderation. M: proteins x samples (log2)."""
    mm = meta.set_index('SampleID').loc[M.columns]
    sev = (mm.Severity=='Severe').astype(float).values
    imm = (mm.Immune=='Immunosuppressed').astype(float).values
    X_full = np.column_stack([np.ones(len(sev)), sev, imm, sev*imm])
    names = ['Intercept','Severity','Immune','Interaction']
    res={}
    for p in M.index:
        y = M.loc[p].values.astype(float); m = np.isfinite(y)
        if m.sum() < 6: continue
        X = X_full[m]; yy = y[m]
        if np.linalg.matrix_rank(X) < X.shape[1]: continue
        XtXi = np.linalg.pinv(X.T@X)
        b = XtXi@X.T@yy
        r = yy - X@b
        dfr = m.sum() - X.shape[1]
        if dfr < 1: continue
        s2 = (r@r)/dfr
        res[p] = dict(df=dfr, s2=s2, **{f"b_{n}":bv for n,bv in zip(names,b)},
                      **{f"v_{n}":XtXi[i,i] for i,n in enumerate(names)}, n_obs=int(m.sum()))
    R = pd.DataFrame(res).T
    d0, s02 = squeeze_var(R.s2.values, R.df.values)
    R['s2_post'] = (R.df*R.s2 + d0*s02)/(R.df + d0)
    R['df_total'] = R.df + d0
    out={}
    for c in coefs:
        se = np.sqrt(R.s2_post * R[f'v_{c}'])
        t = R[f'b_{c}']/se
        p = 2*stats.t.sf(np.abs(t), R.df_total)
        _, q = stats.false_discovery_control(p, method='bh'), None
        tab = pd.DataFrame({'log2FC':R[f'b_{c}'].values, 'SE':se.values, 't':t.values,
                            'P':p, 'n_obs':R.n_obs.values}, index=R.index)
        tab['FDR'] = stats.false_discovery_control(tab.P.values, method='bh')
        out[c]=tab.sort_values('P')
    return out, d0, s02, R

