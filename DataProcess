import statsmodels.formula.api as smf
mt2 = mt.copy(); mt2['Sev']=(mt2.Severity=='Severe').astype(int); mt2['Imm']=(mt2.Immune=='Immunosuppressed').astype(int)

def target_stats(M, level='protein'):
    rows=[]
    for f in M.index:
        y = M.loc[f]
        df = pd.DataFrame({'y':y.values,'Sev':mt2.Sev.values,'Imm':mt2.Imm.values,
                           'Age':mt2.Age.values,'Male':(mt2.Sex=='Male').astype(int).values}).dropna()
        if df.y.nunique()<5: continue
        m1 = smf.ols("y ~ Sev + Imm + Sev:Imm", df).fit()
        m2 = smf.ols("y ~ Sev + Imm + Age + Male", df).fit()
        a = df.y[df.Sev==1]; b = df.y[df.Sev==0]
        u = stats.mannwhitneyu(a,b)
        n1,n0=len(a),len(b)
        auc = u.statistic/(n1*n0)
        sp = np.sqrt(((n1-1)*a.var(ddof=1)+(n0-1)*b.var(ddof=1))/(n1+n0-2))
        rows.append(dict(Feature=f,
            log2FC=a.mean()-b.mean(), Cohens_d=(a.mean()-b.mean())/sp,
            P_MWU=u.pvalue, AUC=auc,
            beta_Sev=m1.params['Sev'], P_Sev=m1.pvalues['Sev'],
            beta_Imm=m1.params['Imm'], P_Imm=m1.pvalues['Imm'],
            beta_Int=m1.params['Sev:Imm'], P_Int=m1.pvalues['Sev:Imm'],
            beta_Sev_adj=m2.params['Sev'], P_Sev_adj=m2.pvalues['Sev'],
            n=len(df)))
    D=pd.DataFrame(rows).set_index('Feature')
    for c in ['P_MWU','P_Sev','P_Imm','P_Int','P_Sev_adj']:
        D['FDR'+c[1:]] = stats.false_discovery_control(D[c].values, method='bh')
    return D

