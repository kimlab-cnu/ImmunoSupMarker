def nested_cv(Xd, yv, Cgrid=(0.01,0.03,0.1,0.3,1,3), n_rep=20, seed=0, model='l1'):
    """Repeated stratified nested CV; inner loop tunes C, outer estimates AUC."""
    aucs=[]; probs=np.zeros((n_rep, len(yv))); sel_counts={}
    for rep in range(n_rep):
        outer=StratifiedKFold(5, shuffle=True, random_state=seed+rep)
        pr=np.zeros(len(yv))
        for tr,te in outer.split(Xd,yv):
            pipe=Pipeline([('imp',SimpleImputer(strategy='median')),('sc',StandardScaler()),
                ('clf',LogisticRegression(penalty=model,solver='liblinear',max_iter=5000))])
            gs=GridSearchCV(pipe,{'clf__C':Cgrid},cv=StratifiedKFold(4,shuffle=True,random_state=rep),scoring='roc_auc',n_jobs=-1)
            gs.fit(Xd.iloc[tr],yv[tr])
            pr[te]=gs.predict_proba(Xd.iloc[te])[:,1]
            co=gs.best_estimator_.named_steps['clf'].coef_[0]
            for f in Xd.columns[co!=0]: sel_counts[f]=sel_counts.get(f,0)+1
        aucs.append(roc_auc_score(yv,pr)); probs[rep]=pr
    return np.array(aucs), probs, pd.Series(sel_counts).sort_values(ascending=False)

