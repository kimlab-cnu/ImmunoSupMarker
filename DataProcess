from sklearn.base import BaseEstimator, TransformerMixin
class MWUSelect(BaseEstimator, TransformerMixin):
    """Rank features by Mann-Whitney U p-value on TRAINING data only."""
    def __init__(self, k=8): self.k=k
    def fit(self, X, yv):
        Xa=np.asarray(X,float); yv=np.asarray(yv)
        p=np.ones(Xa.shape[1])
        for j in range(Xa.shape[1]):
            a=Xa[yv==1,j]; bb=Xa[yv==0,j]
            a=a[np.isfinite(a)]; bb=bb[np.isfinite(bb)]
            if len(a)>2 and len(bb)>2: p[j]=stats.mannwhitneyu(a,bb).pvalue
        self.idx_=np.argsort(p)[:self.k]; self.p_=p
        return self
    def transform(self, X): return np.asarray(X,float)[:,self.idx_]

def nested_cv_sel(Xd, yv, k_grid=(4,6,8,12), Cgrid=(0.03,0.1,0.3,1,3), n_rep=20, seed=0):
    aucs=[]; probs=[]; picks={}
    for rep in range(n_rep):
        pr=np.zeros(len(yv))
        for tr,te in StratifiedKFold(5,shuffle=True,random_state=seed+rep).split(Xd,yv):
            pipe=Pipeline([('imp',SimpleImputer(strategy='median')),('sel',MWUSelect()),
                           ('sc',StandardScaler()),('clf',LogisticRegression(l1_ratio=0.0,solver='liblinear',max_iter=20000))])
            gs=GridSearchCV(pipe,{'sel__k':list(k_grid),'clf__C':list(Cgrid)},
                            cv=StratifiedKFold(4,shuffle=True,random_state=rep),scoring='roc_auc',n_jobs=-1)
            gs.fit(Xd.iloc[tr],yv[tr]); pr[te]=gs.predict_proba(Xd.iloc[te])[:,1]
            be=gs.best_estimator_
            for f in Xd.columns[be.named_steps['sel'].idx_]: picks[f]=picks.get(f,0)+1
        aucs.append(roc_auc_score(yv,pr)); probs.append(pr)
    return np.array(aucs), np.array(probs), pd.Series(picks).sort_values(ascending=False)

